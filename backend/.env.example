DATABASE_URL=postgres://user:password@localhost:5432/agora_v2
DB_POOL_MAX=10
DB_LOCK_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# Optional — activates real pgvector embeddings (Gemini text-embedding-004, 768 dims).
# Leave unset to keep the zero-dependency lexical retrieval stub.

# Agora LLM configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash

# Provider credentials
GEMINI_API_KEY=your-key

# Agora LLM configuration
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5

# Provider credentials
ANTHROPIC_API_KEY=your-key

PORT=4000
AGORA_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# Real LMS credentials go here once you register Agora as an external tool —
# see lti/platformConfig.ts for the Canvas/Moodle registration block.
# CANVAS_CLIENT_ID=
# MOODLE_CLIENT_ID=

# Emails
RESEND_API_KEY=
EMAIL_FROM="Agora <login@example.com>"

ENABLE_MOCK_PLATFORM=true

# Rate limiting (required in production; local dev falls back to an in-memory limiter when unset)
REDIS_URL=redis://localhost:6379
# Reverse-proxy hops in front of the app. Render = 1 (default in production), local = 0.
# TRUST_PROXY=1

# Session cookies are host-only. Use lax with sibling domains (app.example.com / api.example.com).
# Use none ONLY if the app itself must run inside the LMS iframe; it forces Secure cookies.
COOKIE_SAME_SITE=lax

# Dev only: pre-approve mock LMS courses (launches for unmapped contexts are rejected).
# Format: class-code:curriculum-pack-id,class-code:curriculum-pack-id
# MOCK_CURRICULUM_MAPPINGS=ENG8:cambridge-stage8-english