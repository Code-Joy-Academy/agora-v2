DATABASE_URL=postgres://user:password@localhost:5432/agora_v2

# Optional — activates real pgvector embeddings (Gemini text-embedding-004, 768 dims).
# Leave unset to keep the zero-dependency lexical retrieval stub.

# Agora LLM configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash

# Provider credentials
GEMINI_API_KEY=your-key

# Agora LLM configuration
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5

# Provider credentials
ANTHROPIC_API_KEY=your-key

PORT=4000
AGORA_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Real LMS credentials go here once you register Agora as an external tool —
# see lti/platformConfig.ts for the Canvas/Moodle registration block.
# CANVAS_CLIENT_ID=
# MOODLE_CLIENT_ID=
